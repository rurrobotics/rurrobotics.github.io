---
import PageLayout from "@layouts/PageLayout.astro";
import ErrorSection from "@components/sections/ErrorSection.astro";
---

<PageLayout description="The page you're looking for doesn't exist." showJoinSection={false}>
	<ErrorSection
		code="404"
		label="Error 404"
		title="Page not found"
		message="The page you're looking for doesn't exist or has been moved."
		linkLabel="Back to home"
	/>
</PageLayout>
