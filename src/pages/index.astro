---
import About from "../components/About.astro";
import Contact from "../components/Contact.astro";
import Hero from "../components/Hero.astro";
import Pattern from "../components/Pattern.astro";
import Sponsors from "../components/Sponsors.astro";
import Team from "../components/Team.astro";
import PageLayout from "../layouts/PageLayout.astro";
---

<PageLayout>
	<Pattern />
	<Hero class="min-h-screen" />
	<About
		order="01"
		specs={[
			{ name: "Years competing", text: "3" },
			{ name: "University", text: "Belgrade" },
			{ name: "Team members", text: "8" },
			{ name: "League", text: "Senior" },
		]}
	/>
	<Team
		order="02"
		members={[
			{
				name: "Aleksa Bolić",
				faculty: "Faculty of Mathematics",
				source: "/src/assets/team/bolic.jpg",
			},
			{
				name: "Aleksa Ognjanović",
				faculty: "Faculty of Electrical Engineering",
				source: "/src/assets/team/ognjanovic.jpg",
			},
			{
				name: "Aleksej Milenković",
				faculty: "Faculty of Mechanical Engineering",
				source: "/src/assets/team/milenkovic.jpg",
			},
			{
				name: "Filip Grujović",
				faculty: "Faculty of Electrical Engineering",
				source: "/src/assets/team/grujic.jpg",
			},
			{
				name: "Marko Mihajlović",
				faculty: "Faculty of Electrical Engineering",
