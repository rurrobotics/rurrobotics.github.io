---
import About from "../components/About.astro";
import Contact from "../components/Contact.astro";
import Hero from "../components/Hero.astro";
import Pattern from "../components/Pattern.astro";
import Sponsors from "../components/Sponsors.astro";
import Team from "../components/Team.astro";
import PageLayout from "../layouts/PageLayout.astro";
---

<PageLayout>
	<Pattern />
	<Hero class="min-h-screen" />
	<About
		order="01"
		specs={[
			{ name: "Years competing", text: "3" },
			{ name: "University", text: "Belgrade" },
			{ name: "Team members", text: "8" },
			{ name: "League", text: "Senior" },
		]}
	/>
	<Team
		order="02"
		members={[
			{
				name: "Aleksa Bolić",
				faculty: "Faculty of Mathematics",
				source: "/src/assets/bolic.jpg",
			},
			{
				name: "Aleksa Ognjanović",
				faculty: "Faculty of Electrical Engineering",
				source: "/src/assets/ognjanovic.jpg",
			},
			{
				name: "Aleksej Milenković",
				faculty: "Faculty of Mechanical Engineering",
				source: "/src/assets/milenkovic.jpg",
			},
			{
				name: "Filip Grujović",
				faculty: "Faculty of Electrical Engineering",
				source: "/src/assets/grujic.jpg",
			},
			{
				name: "Marko Mihajlović",
				faculty: "Faculty of Electrical Engineering",
				source: "/src/assets/mihajlovic.jpg",
			},
			{
				name: "Marko Samardžija",
				faculty: "Faculty of Mechanical Engineering",
				source: "/src/assets/samardzija.jpg",
			},
			{
				name: "Mihailo Pesić",
				faculty:
					"Faculty of Electrical Engineering of STU in Bratislava",
				source: "/src/assets/pesic.jpg",
			},
			{
				name: "Miloš Krneta",
				faculty: "Faculty of Electrical Engineering",
				source: "/src/assets/krneta.jpg",
			},
			{
				name: "Stefan Tešmanović",
				faculty: "Faculty of Electrical Engineering",
				source: "/src/assets/tesmanovic.jpg",
			},
			{ name: "Vukašin Rondović", faculty: "Ex-member" },
		]}
	/>
	<Sponsors
		order="03"
		sponsors={[
			{
				name: "Telix",
				source: "/src/assets/telix.png",
				class: "brightness-0",
			},
			{
				name: "Insist Elektrik",
				source: "/src/assets/insist.png",
				class: "brightness-0",
			},
		]}
	/>
	<Contact order="04" />
