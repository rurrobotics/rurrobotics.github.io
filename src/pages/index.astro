---
import About from "../components/About.astro";
import Contact from "../components/Contact.astro";
import Gallery from "../components/Gallery.astro";
import Hero from "../components/Hero.astro";
import Navbar from "../components/Navbar.astro";
import Pattern from "../components/Pattern.astro";
import Sponsors from "../components/Sponsors.astro";
import Team from "../components/Team.astro";
import PageLayout from "../layouts/PageLayout.astro";
---

<PageLayout
	description="University of Belgrade team developing innovative autonomous robots for the Eurobot competition."
	url={import.meta.env.DEV ? Astro.url.origin : Astro.site?.toString()}
	image="/banner.svg"
	keywords={["eurobot", "rurrobotics", "rur"]}
>
	<Pattern />
	<header class="fixed w-full top-0 z-50">
		<Navbar
			links={[
				{ name: "About us", href: "#about" },
				{ name: "Team", href: "#team" },
				{ name: "Gallery", href: "#gallery" },
				{ name: "Sponsors", href: "#sponsors" },
				{ name: "Contact", href: "#contact" },
			]}
		/>
	</header>
	<div class="min-h-screen flex flex-col" id="start">
		<div class="opacity-0">
			<!-- Dummy -->
			<Navbar />
		</div>
		<Hero class="flex-1" />
	</div>
	<About
		order="01"
		specs={[
			{ name: "Years competing", text: "3" },
			{ name: "University", text: "Belgrade" },
			{ name: "Team members", text: "12" },
			{ name: "League", text: "Senior" },
		]}
	/>
	<Team
		order="02"
		members={[
			{
				name: "Aleksa Bolić",
				faculty: "Faculty of Mathematics, University of Belgrade",
				source: "/src/assets/team/bolic.jpg",
			},
			{
				name: "Aleksa Ognjanović",
				faculty:
					"Faculty of Electrical Engineering, University of Belgrade",
				source: "/src/assets/team/ognjanovic.jpg",
			},
			{
				name: "Aleksej Milenković",
				faculty:
					"Faculty of Mechanical Engineering, University of Belgrade",
				source: "/src/assets/team/milenkovic.jpg",
			},
			{
				name: "Filip Grujović",
				faculty:
					"Faculty of Electrical Engineering, University of Belgrade",
				source: "/src/assets/team/grujic.jpg",
			},
			{
				name: "Marko Mihajlović",
				faculty:
					"Faculty of Electrical Engineering, University of Belgrade",
				source: "/src/assets/team/mihajlovic.jpg",
			},
			{
				name: "Marko Samardžija",
				faculty:
					"Faculty of Mechanical Engineering, University of Belgrade",
				source: "/src/assets/team/samardzija.jpg",
			},
			{
				name: "Mihailo Pesić",
				faculty: "Faculty of Electrical Engineering, STU in Bratislava",
				source: "/src/assets/team/pesic.jpg",
			},
			{
				name: "Miloš Krneta",
				faculty:
					"Faculty of Electrical Engineering, University of Belgrade",
				source: "/src/assets/team/krneta.jpg",
			},
			{
				name: "Stefan Tešmanović",
				faculty:
					"Faculty of Electrical Engineering, University of Belgrade",
				source: "/src/assets/team/tesmanovic.jpg",
			},
			{
				name: "Tamara Radmilović",
				faculty:
					"Faculty of Technical Sciences, University of Novi Sad",
				source: "/src/assets/team/radmilovic.jpg",
			},
			{
				name: "Vukašin Rondović",
				faculty: "Polytechnic University of Turin",
				source: "/src/assets/team/rondovic.jpg",
			},
		]}
	/>
	<Gallery order="03" />
	<Sponsors
		order="04"
		sponsors={[
			{
				name: "RBT",
				href: "https://rbt.rs/",
				source: "/src/assets/sponsor/rbt.svg",
			},
			{
				name: "Zanus",
				href: "https://zanustechnology.com/",
				source: "/src/assets/sponsor/zanus.png",
			},
			{
				name: "3D Republika",
				href: "https://3drepublika.com/",
				source: "/src/assets/sponsor/3drepublika.png",
			},
			{
				name: "Telix",
				href: "https://www.telix.rs/",
				source: "/src/assets/sponsor/telix.png",
				class: "brightness-0",
			},
			{
				name: "Insist Elektrik",
				href: "http://www.insistelektrik.com/",
				source: "/src/assets/sponsor/insist.png",
				class: "brightness-0",
			},
			{
				name: "CNC Obrada",
				href: "https://cncobrada.com/",
				source: "/src/assets/sponsor/cncobrada.png",
			},
		]}
	/>
	<Contact order="05" />
</PageLayout>
