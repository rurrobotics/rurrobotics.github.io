---
import Layout from "../../layouts/Layout.astro";
import { locales } from "../../i18n/ui";
import { useTranslations } from "../../i18n/utils";
import { langStaticPaths } from "../../i18n/paths";

export const getStaticPaths = langStaticPaths;

const { lang } = Astro.params;
const t = useTranslations(lang as keyof typeof locales);
---

<Layout title={t("site.title")}>
	<h1 class="text-3xl font-bold text-primary">{t("site.title")}</h1>
</Layout>
