---
import AboutSection from "@components/sections/AboutSection.astro";
import ProjectsSection from "@components/sections/ProjectsSection.astro";
import ArticlesSection from "@components/sections/ArticlesSection.astro";
import EventsSection from "@components/sections/EventsSection.astro";
import GallerySection from "@components/sections/GallerySection.astro";
import SponsorsSection from "@components/sections/SponsorsSection.astro";
import SectionRow from "@components/ui/SectionRow.astro";
import PageLayout from "@layouts/PageLayout.astro";
import { getContactEmail } from "@lib/contact";
import { socials } from "@lib/socials";
import logo from "@/assets/logo.svg";

export { getStaticPaths } from "@locales/utils";

const organization = {
	"@context": "https://schema.org",
	"@type": "Organization",
	name: "RUR Robotics",
	alternateName: ["RUR Robotika", "РУР Роботика"],
	url: Astro.site?.href,
	logo: new URL(logo.src, Astro.site).href,
	email: getContactEmail(Astro.currentLocale),
	foundingDate: "2023",
	parentOrganization: {
		"@type": "CollegeOrUniversity",
		name: "School of Electrical Engineering, University of Belgrade",
	},
	address: {
		"@type": "PostalAddress",
		streetAddress: "Bulevar kralja Aleksandra 73",
		addressLocality: "Belgrade",
		addressCountry: "RS",
	},
	sameAs: socials.map(({ href }) => href),
};
---

<PageLayout
	structuredData={organization}
	description="RUR Robotics is the robotics club of the School of Electrical Engineering at the University of Belgrade. We build autonomous robots and compete in Eurobot."
>
	<h1 class="sr-only">RUR Robotics</h1>
	<AboutSection />
	<ProjectsSection />
	<SectionRow>
		<EventsSection />
		<ArticlesSection />
	</SectionRow>
	<GallerySection />
	<SponsorsSection />
</PageLayout>
