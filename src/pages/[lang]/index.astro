---
import AboutSection from "@components/about/AboutSection.astro";
import ProjectsSection from "@components/projects/ProjectsSection.astro";
import ArticlesSection from "@components/articles/ArticlesSection.astro";
import EventsSection from "@components/events/EventsSection.astro";
import GallerySection from "@components/gallery/GallerySection.astro";
import SponsorsSection from "@components/sponsors/SponsorsSection.astro";
import SectionRow from "@components/common/SectionRow.astro";
import PageLayout from "@layouts/PageLayout.astro";

export { getStaticPaths } from "../../locales/utils";
---

<PageLayout
	description="RUR Robotics is the robotics club of the School of Electrical Engineering at the University of Belgrade. We build autonomous robots and compete in Eurobot."
>
	<AboutSection />
	<ProjectsSection />
	<SectionRow>
		<EventsSection />
		<ArticlesSection />
	</SectionRow>
	<GallerySection />
	<SponsorsSection />
</PageLayout>
