---
import AboutSection from "@components/sections/AboutSection.astro";
import ProjectsSection from "@components/sections/ProjectsSection.astro";
import ArticlesSection from "@components/sections/ArticlesSection.astro";
import EventsSection from "@components/sections/EventsSection.astro";
import GallerySection from "@components/sections/GallerySection.astro";
import SponsorsSection from "@components/sections/SponsorsSection.astro";
import SectionRow from "@components/ui/SectionRow.astro";
import PageLayout from "@layouts/PageLayout.astro";

export { getStaticPaths } from "@locales/utils";
---

<PageLayout
	description="RUR Robotics is the robotics club of the School of Electrical Engineering at the University of Belgrade. We build autonomous robots and compete in Eurobot."
>
	<AboutSection />
	<ProjectsSection />
	<SectionRow>
		<EventsSection />
		<ArticlesSection />
	</SectionRow>
	<GallerySection />
	<SponsorsSection />
</PageLayout>
