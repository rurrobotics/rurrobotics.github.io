---
import { getCollection, render } from "astro:content";
import {
	EVENT_TIME_ZONE,
	isEventCategory,
	parseArticleId,
	type Article,
} from "@lib/articles";
import { localeTags } from "@locales/config.js";
import { pageLocale } from "@locales/utils";
import PageLayout from "@layouts/PageLayout.astro";
import CategoryBadge from "@components/ui/CategoryBadge.astro";

export async function getStaticPaths() {
	const articles = await getCollection(
		"articles",
		({ data }) => import.meta.env.DEV || !data.draft,
	);
	return articles.map((entry) => {
		const { locale, slug } = parseArticleId(entry.id);
		return { params: { lang: locale, slug }, props: { entry } };
	});
}

interface Props {
	entry: Article;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { data } = entry;

const localeTag = localeTags[pageLocale(Astro.currentLocale)];

const eventDate =
	isEventCategory(data.category) && "eventDate" in data
		? data.eventDate
		: undefined;

const dateOptions: Intl.DateTimeFormatOptions = {
	day: "numeric",
	month: "long",
	year: "numeric",
	timeZone: EVENT_TIME_ZONE,
};
const dateFmt = new Intl.DateTimeFormat(localeTag, dateOptions);
// One formatter for both, so each locale joins date and time its own way.
const dateTimeFmt = new Intl.DateTimeFormat(localeTag, {
	...dateOptions,
	hour: "2-digit",
	minute: "2-digit",
});

interface MetaItem {
	label: string;
	value: string;
	/** Renders the value as a <time> element. */
	datetime?: Date;
}

const meta = [
	eventDate && {
		label: "Event date",
		value: dateTimeFmt.format(eventDate),
		datetime: eventDate,
	},
	data.author && { label: "Author", value: data.author },
	{
		label: "Published",
		value: dateFmt.format(data.date),
		datetime: data.date,
	},
].filter((item): item is MetaItem => Boolean(item));
---

<PageLayout
	title={data.title}
	description={data.description ?? data.title}
	image={data.hero}
	imageAlt={data.heroAlt}
	type="article"
>
	<article class="mx-auto w-full max-w-4xl px-5 py-10 sm:px-8 md:px-12 md:py-16">
		<header class="mb-10 md:mb-12">
			<CategoryBadge category={data.category} />
			<h1 class="mt-4 font-display text-4xl leading-none font-bold text-foreground uppercase sm:text-6xl">
				{data.title}
			</h1>
			{data.description && (
				<p class="mt-5 text-base leading-relaxed text-ink-muted md:text-lg">
					{data.description}
				</p>
			)}
			<dl class="mt-6 grid grid-cols-2 gap-x-8 gap-y-4 sm:flex sm:gap-x-12">
				{meta.map(({ label, value, datetime }) => (
					<div>
						<dt class="font-mono text-xs tracking-widest text-muted uppercase">
							{label}
						</dt>
						<dd class="mt-1 text-foreground">
							{datetime ? (
								<time datetime={datetime.toISOString()}>
									{value}
								</time>
							) : (
								value
							)}
						</dd>
					</div>
				))}
			</dl>
		</header>

		<div class="prose max-w-none">
			<Content />
		</div>
	</article>
</PageLayout>

<script>
	document
		.querySelectorAll<HTMLButtonElement>(".code-block [data-copy]")
		.forEach((button) => {
			button.addEventListener("click", async () => {
				const code = button
					.closest(".code-block")
					?.querySelector("pre")?.textContent;
				if (!code) return;

				try {
					await navigator.clipboard.writeText(code);
					const previous = button.textContent;
					button.textContent = "Copied";
					setTimeout(() => (button.textContent = previous), 1500);
				} catch {
					button.textContent = "Failed";
				}
			});
		});
</script>
