---
import { getCollection, render } from "astro:content";
import { parseArticleId, type Article } from "@/articles";
import PageLayout from "@layouts/PageLayout.astro";
import ArticleMasthead from "@components/articles/ArticleMasthead.astro";
import ArticleToc from "@components/articles/ArticleToc.astro";
import ArticleShare from "@components/articles/ArticleShare.astro";
import MoreArticles from "@components/articles/MoreArticles.astro";

export async function getStaticPaths() {
	const articles = await getCollection(
		"articles",
		({ data }) => import.meta.env.DEV || !data.draft,
	);
	return articles.map((entry) => {
		const { locale, slug } = parseArticleId(entry.id);
		return { params: { lang: locale, slug }, props: { entry } };
	});
}

interface Props {
	entry: Article;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const shareUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
---

<PageLayout join={false}>
	<ArticleMasthead article={entry} />

	<div
		class="container mx-auto grid items-start gap-10 px-5 py-10 sm:px-10 md:px-15 md:py-14 lg:grid-cols-[minmax(0,1fr)_260px] lg:gap-14"
	>
		<article class="prose w-full max-w-225">
			<Content />
		</article>
		<!-- The rail is desktop-only: below lg it would land under the text it indexes. -->
		<aside class="hidden flex-col gap-6 lg:sticky lg:top-6 lg:flex">
			<ArticleToc headings={headings} />
			<ArticleShare url={shareUrl} title={entry.data.title} />
		</aside>
	</div>

	<MoreArticles current={entry} />
</PageLayout>

<script>
	document
		.querySelectorAll<HTMLButtonElement>(".code-block [data-copy]")
		.forEach((button) => {
			button.addEventListener("click", async () => {
				const code = button
					.closest(".code-block")
					?.querySelector("pre")?.textContent;
				if (!code) return;

				try {
					await navigator.clipboard.writeText(code);
					const previous = button.textContent;
					button.textContent = "Copied";
					setTimeout(() => (button.textContent = previous), 1500);
				} catch {
					button.textContent = "Failed";
				}
			});
		});
</script>
