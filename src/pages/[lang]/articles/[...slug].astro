---
import { getCollection, render } from "astro:content";
import { parseArticleId, type Article } from "@/articles";
import PageLayout from "@layouts/PageLayout.astro";

export async function getStaticPaths() {
	const articles = await getCollection(
		"articles",
		({ data }) => import.meta.env.DEV || !data.draft,
	);
	return articles.map((entry) => {
		const { locale, slug } = parseArticleId(entry.id);
		return { params: { lang: locale, slug }, props: { entry } };
	});
}

interface Props {
	entry: Article;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<PageLayout>
	<article
		class="prose mx-auto w-full max-w-4xl px-5 py-10 sm:px-8 md:px-12 md:py-16"
	>
		<Content />
	</article>
</PageLayout>

<script>
	document
		.querySelectorAll<HTMLButtonElement>(".code-block [data-copy]")
		.forEach((button) => {
			button.addEventListener("click", async () => {
				const code = button
					.closest(".code-block")
					?.querySelector("pre")?.textContent;
				if (!code) return;

				try {
					await navigator.clipboard.writeText(code);
					const previous = button.textContent;
					button.textContent = "Copied";
					setTimeout(() => (button.textContent = previous), 1500);
				} catch {
					button.textContent = "Failed";
				}
			});
		});
</script>
