---
interface Props {
	order: string;
	title: string;
	class?: string;
}

const { order, title, class: className } = Astro.props;
---

<div class:list={["flex items-center gap-4 mb-8", className]}>
	<div class="size-12 flex items-center justify-center bg-black text-bg">
		<span class="text-2xl font-bold">{order}</span>
	</div>
	<h2 class="text-4xl md:text-5xl font-bold uppercase">{title}</h2>
</div>
