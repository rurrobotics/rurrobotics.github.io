---
import { getArticles, isEventCategory } from "@/articles";
import { defaultLocale, type Locale } from "@locales/config.js";
import Section from "@components/common/Section.astro";
import SectionTitle from "@components/common/SectionTitle.astro";
import ArticleCard from "@components/common/ArticleCard.astro";
import SectionLink from "@components/common/SectionLink.astro";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const articles = (await getArticles(locale)).filter(
	(a) => !isEventCategory(a.data.category),
);
---

<Section id="articles" color="tertiary">
	<SectionTitle slot="title">Articles</SectionTitle>
	<SectionLink slot="link" href={`/${locale}/articles/`} color="secondary">All articles</SectionLink>
	{
		articles.length === 0 ? (
			<p class="font-mono text-sm opacity-75">No articles yet.</p>
		) : (
			<ul class="grid grid-cols-1 gap-6">
				{articles.slice(0, 4).map((article) => (
					<ArticleCard article={article} />
				))}
			</ul>
		)
	}
</Section>
