---
import { Image } from "astro:assets";
import {
	ARTICLE_CATEGORIES,
	EVENT_CATEGORIES,
	articleListHref,
} from "@lib/articles";
import { pageLocale } from "@locales/utils";
import NavLink from "@components/layout/NavLink.astro";
import LocaleSwitcher from "@components/layout/LocaleSwitcher.astro";
import logo from "@/assets/logo.svg";

const locale = pageLocale(Astro.currentLocale);
const home = `/${locale}/`;

const onHome = Astro.url.pathname === home;

const sectionHref = (id: string, page?: string) =>
	onHome || !page ? `${home}#${id}` : page;

const links = [
	{ id: "projects", label: "Projects" },
	{
		id: "events",
		label: "Events",
		page: articleListHref(locale, EVENT_CATEGORIES),
	},
	{
		id: "articles",
		label: "Articles",
		page: articleListHref(locale, ARTICLE_CATEGORIES),
	},
	{ id: "gallery", label: "Gallery", page: `${home}gallery/` },
	{ id: "sponsors", label: "Partners" },
].map((link) => ({ ...link, href: sectionHref(link.id, link.page) }));
const joinHref = `${home}join/`;

const onArticles = Astro.url.pathname.includes("/articles");
const onGallery = Astro.url.pathname.includes("/gallery");
const isCurrent = (id: string) =>
	(id === "articles" && onArticles) || (id === "gallery" && onGallery);

const gutter = "px-5 sm:px-10 md:px-15";
const inner = `mx-auto container ${gutter}`;
---

<header class="sticky top-0 z-20 border-b-4 border-foreground bg-background">
	<div
		class:list={[
			"mx-auto container flex items-stretch justify-between",
			gutter,
		]}
	>
		<a href={home} class="flex items-center gap-3 py-4">
			<Image
				src={logo}
				alt=""
				width={32}
				loading="eager"
				class="size-8 shrink-0"
			/>
			<span class="font-display text-xl font-bold tracking-wider uppercase">
				RUR Robotics
			</span>
		</a>

		<nav class="relative hidden items-stretch xl:flex" data-nav>
			{links.map((link) => (
				<NavLink
					href={link.href}
					section={link.id}
					current={isCurrent(link.id)}
					class="flex items-center px-4 text-sm"
				>
					{link.label}
				</NavLink>
			))}
			<NavLink
				href={joinHref}
				class="flex items-center bg-secondary px-6.5 text-sm text-secondary-foreground"
			>
				<span>Join us</span>
			</NavLink>
			<span class="-mr-2.5 flex items-center pl-2 font-mono text-xs tracking-wider">
				<LocaleSwitcher />
			</span>
			<span
				data-notch
				data-visible="false"
				class="pointer-events-none absolute bottom-0 h-0 bg-primary transition-[left,width,height] duration-150 ease-out data-[visible=true]:h-1.5"
			></span>
		</nav>

		<button
			type="button"
			popovertarget="mobile-menu"
			aria-label="Menu"
			class="group -mr-5 flex cursor-pointer items-center px-5 xl:hidden"
		>
			<span class="flex flex-col gap-1.5">
				<span class="h-1 w-6 bg-foreground transition-transform duration-200 ease-out group-has-[+_#mobile-menu:popover-open]:translate-y-2.5 group-has-[+_#mobile-menu:popover-open]:rotate-45"></span>
				<span class="h-1 w-6 bg-foreground transition-[opacity,scale] duration-200 ease-out group-has-[+_#mobile-menu:popover-open]:scale-x-0 group-has-[+_#mobile-menu:popover-open]:opacity-0"></span>
				<span class="h-1 w-6 bg-foreground transition-transform duration-200 ease-out group-has-[+_#mobile-menu:popover-open]:-translate-y-2.5 group-has-[+_#mobile-menu:popover-open]:-rotate-45"></span>
			</span>
		</button>
		<nav
			id="mobile-menu"
			popover
			class="peer top-16 w-full flex-col border-b-4 border-foreground bg-background text-foreground max-xl:open:flex xl:hidden"
		>
			{links.map((link) => (
				<NavLink
					href={link.href}
					current={isCurrent(link.id)}
					class="py-3.5 text-lg"
				>
					<span class:list={["block", inner]}>{link.label}</span>
				</NavLink>
			))}
			<NavLink
				href={joinHref}
				class="bg-secondary py-3.5 text-lg text-secondary-foreground"
			>
				<span class:list={["block", inner]}>Join us</span>
			</NavLink>
			<span class="block border-t-4 border-foreground py-3 font-mono text-xs tracking-wider">
				<span class:list={["flex gap-1", inner]}>
					<LocaleSwitcher />
				</span>
			</span>
		</nav>
		<div class="fixed inset-x-0 top-16 bottom-0 hidden bg-black/50 max-xl:peer-open:block"></div>
	</div>
</header>

<script>
	import { sectionNotch } from "@/scripts/section-notch";

	const nav = document.querySelector<HTMLElement>("[data-nav]");
	const notch = document.querySelector<HTMLElement>("[data-notch]");

	if (nav && notch) sectionNotch({ nav, notch });

	const menu = document.getElementById("mobile-menu");

	menu?.addEventListener("click", (event) => {
		if ((event.target as Element).closest("a")) menu.hidePopover();
	});
</script>
