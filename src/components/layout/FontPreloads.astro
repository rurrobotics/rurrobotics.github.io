---
import { pageLocale } from "@locales/utils";
import { preloadedFonts } from "@lib/fonts";

const locale = pageLocale(Astro.currentLocale);
const links = preloadedFonts[locale].map(
	(href) =>
		`<link rel="preload" as="font" type="font/woff2" href="${href}" crossorigin="anonymous" />`,
);
---

<Fragment set:html={links.join("")} />
