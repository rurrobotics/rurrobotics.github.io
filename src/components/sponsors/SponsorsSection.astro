---
import Section from "@components/common/Section.astro";
import SectionTitle from "@components/common/SectionTitle.astro";
import SectionLink from "@components/common/SectionLink.astro";
import { getContactEmail } from "@/contact";
import SponsorTier from "./SponsorTier.astro";
import rbt from "@/assets/sponsors/rbt.svg";
import sistemcd from "@/assets/sponsors/sistemcd.svg";
import pinoles from "@/assets/sponsors/pinoles.svg";
import maxon from "@/assets/sponsors/maxon.svg";
import insist from "@/assets/sponsors/insist.png";
import republika from "@/assets/sponsors/3drepublika.png";
import telix from "@/assets/sponsors/telix.png";
import zanus from "@/assets/sponsors/zanus.png";
import kelco from "@/assets/sponsors/kelco.png";
import malina314 from "@/assets/sponsors/malina314.png";
import elektroleum from "@/assets/sponsors/elektroleum.webp";
import tipteh from "@/assets/sponsors/tipteh.png";

const email = getContactEmail(Astro.currentLocale);

// @wc-ignore
const general = [{ name: "RBT", href: "https://rbt.rs/", logo: rbt }];

// @wc-ignore
const partners = [
	{ name: "Telix", href: "https://www.telix.rs/", logo: telix, class: "bg-[#11153e]" },
	{ name: "Zanus", href: "https://zanustechnology.com/", logo: zanus },
	{ name: "SistemCD", href: "https://sistemcd.rs/", logo: sistemcd, class: "bg-[#191c20]" },
	{ name: "3D Republika", href: "https://3drepublika.com/", logo: republika },
	{ name: "Pinoles", href: "https://www.pinoles.com/", logo: pinoles },
];

// @wc-ignore
const supporters = [
	{ name: "Maxon YEP", href: "https://www.maxongroup.com/en/cooperations/young-engineers-program", logo: maxon, logoClass: "p-3" },
	{ name: "Malina314", href: "https://malina314.com/", logo: malina314 },
	{ name: "Kelco", href: "https://www.kelco.rs/", logo: kelco, class: "bg-[#212121]" },
	{ name: "Elektroleum", href: "https://elektroleum.rs/", logo: elektroleum, class: "bg-[#1d2a3f]" },
	{ name: "Insist Elektrik", href: "http://www.insistelektrik.com/", logo: insist },
	{ name: "Tipteh", href: "https://www.tipteh.rs/", logo: tipteh },
];
---

<Section id="sponsors">
	<SectionTitle slot="title">Partners</SectionTitle>
	<SectionLink slot="link" href={`mailto:${email}`}>Become a partner</SectionLink>
	<p class="mb-10 text-lg leading-relaxed">
		We are grateful to our sponsors for supporting our work and helping us learn, create, and compete.
	</p>

	<div class="flex flex-col gap-10">
		<SponsorTier sponsors={general} size="large" color="primary">General</SponsorTier>
		<SponsorTier sponsors={partners} size="medium" color="tertiary">Partners</SponsorTier>
		<SponsorTier sponsors={supporters} size="small" color="secondary">Support</SponsorTier>
	</div>
</Section>
