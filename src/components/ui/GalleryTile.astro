---
import type { ImageMetadata } from "astro";
import { getImage, Image } from "astro:assets";

interface Props {
	photo: ImageMetadata;
	alt: string;
	class?: string;
	position?: string;
}

const { photo, alt, sizes, class: className, position } = Astro.props;
const zoomed = await getImage({ src: photo, width: 2000 });
---

<div class:list={["relative overflow-hidden", className]}>
	<button
		type="button"
		data-zoom
		data-zoom-src={zoomed.src}
		class="absolute inset-0 size-full cursor-zoom-in"
	>
		<Image
			src={photo}
			alt={alt}
			width={800}
			widths={[400, 800, 1200]}
			{sizes}
			class="size-full object-cover"
			style={position && `object-position: ${position}`}
		/>
	</button>
</div>
