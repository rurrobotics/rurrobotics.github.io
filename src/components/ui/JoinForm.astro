---
import { MoveRight } from "@lucide/astro";
import { actions, isInputError } from "astro:actions";
import { TURNSTILE_SITE_KEY } from "astro:env/server";
import FormField from "@components/ui/FormField.astro";
import { pageLocale } from "@locales/utils";

const locale = pageLocale(Astro.currentLocale);

const result = Astro.getActionResult(actions.apply);
const sent = result !== undefined && !result.error;
const invalid = isInputError(result?.error) ? result.error.fields : {};
const notHuman = result?.error?.code === "FORBIDDEN";
const tooMany = result?.error?.code === "TOO_MANY_REQUESTS";
const values: Record<string, string> = result?.error
	? Object.fromEntries(
			[...(await Astro.request.formData())].map(([k, v]) => [
				k,
				String(v),
			]),
		)
	: {};
---

<form
	method="POST"
	action={actions.apply}
	class="relative flex flex-col gap-5 border-4 border-black bg-background p-6 text-foreground sm:p-8"
>
	<FormField
		name="name"
		autocomplete="name"
		minlength={2}
		value={values.name}
		invalid={!!invalid.name}
	>
		<span slot="label">Name</span>
		<span slot="error">Enter your name.</span>
	</FormField>
	<FormField
		name="email"
		type="email"
		autocomplete="email"
		value={values.email}
		invalid={!!invalid.email}
	>
		<span slot="label">Email</span>
		<span slot="error">Enter a valid email.</span>
	</FormField>
	<FormField
		name="phone"
		type="tel"
		autocomplete="tel"
		pattern="\+?[0-9 ()/\-]{6,20}"
		value={values.phone}
		invalid={!!invalid.phone}
	>
		<span slot="label">Phone number</span>
		<span slot="error">Enter a valid phone number.</span>
	</FormField>
	<FormField
		name="faculty"
		minlength={2}
		value={values.faculty}
		invalid={!!invalid.faculty}
	>
		<span slot="label">Faculty</span>
		<span slot="error">Enter your faculty.</span>
	</FormField>
	<FormField
		name="year"
		type="number"
		min={1}
		max={6}
		value={values.year}
		invalid={!!invalid.year}
	>
		<span slot="label">Year of study</span>
		<span slot="error">Enter a year from 1 to 6.</span>
	</FormField>
	<div
		class="cf-turnstile"
		data-sitekey={TURNSTILE_SITE_KEY}
		data-size="flexible"
		data-theme="light"
	></div>
	{sent && (
		<p
			role="status"
			class="border-4 border-black bg-secondary p-4 font-mono text-sm font-bold text-secondary-foreground"
		>
			Thanks! We got your application and will be in touch soon.
		</p>
	)}
	{notHuman && (
		<p
			role="alert"
			class="border-4 border-black bg-primary p-4 font-mono text-sm font-bold text-primary-foreground"
		>
			We couldn't confirm you're human. Complete the check and try again.
		</p>
	)}
	{tooMany && (
		<p
			role="alert"
			class="border-4 border-black bg-primary p-4 font-mono text-sm font-bold text-primary-foreground"
		>
			Too many applications from this connection. Wait a minute and try
			again.
		</p>
	)}
	{result?.error && !isInputError(result.error) && !notHuman && !tooMany && (
		<p
			role="alert"
			class="border-4 border-black bg-primary p-4 font-mono text-sm font-bold text-primary-foreground"
		>
			Something went wrong. Check your answers and try again.
		</p>
	)}
	<!-- prettier-ignore -->
	<p class="text-sm leading-relaxed">
		By sending this form, you confirm you've read our <a
			href={`/${locale}/privacy/`}
			class="font-bold underline underline-offset-2">privacy policy</a
		>, which explains how we handle your data.
	</p>
	<button
		type="submit"
		class="group wipe wipe-left wipe-primary mt-2 inline-flex items-center justify-between gap-3 border-4 border-black bg-foreground px-6 py-3 font-mono text-sm font-bold tracking-widest text-background uppercase cursor-pointer"
	>
		<span>Send application</span>
		<MoveRight class="size-5 transition-transform group-hover:translate-x-0.5" />
	</button>
</form>

<script
	is:inline
	src="https://challenges.cloudflare.com/turnstile/v0/api.js"
	async
	defer
></script>
