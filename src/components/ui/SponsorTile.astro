---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
	/** Omit for a placeholder tile. */
	name?: string;
	href?: string;
	logo?: ImageMetadata;
	/** Extra classes for the logo image. */
	logoClass?: string;
	size?: "large" | "medium" | "small";
	/** Extra classes for the tile itself. */
	class?: string;
}

const {
	name,
	href,
	logo,
	logoClass,
	size = "medium",
	class: className,
} = Astro.props;
const Tag = href ? "a" : "div";

const logoHeights = { large: 144, medium: 96, small: 100 };

const sizeClasses = {
	large: "h-32 border-4 p-6",
	medium: "h-24 border-4 p-5",
	small: "h-20 border-3 p-3",
};
---

<Tag
	href={href}
	class:list={[
		"flex items-center justify-center",
		sizeClasses[size],
		name === undefined && "border-dashed text-muted",
		className,
	]}
>
	{
		logo ? (
			<Image
				src={logo}
				alt={name ?? ""}
				height={logoHeights[size]}
				class:list={["max-h-full w-auto object-contain", logoClass]}
			/>
		) : (
			<span class="text-center font-mono text-xs font-bold uppercase tracking-widest">{name ?? "Logo"}</span>
		)
	}
</Tag>
