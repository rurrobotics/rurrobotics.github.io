---
interface Props {
	class?: string;
	size?: "default" | "large";
	as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
	dot?: boolean;
	color?: "primary" | "secondary" | "accent" | "tertiary" | "black";
}

const {
	class: className,
	size = "default",
	as: Tag = "h2",
	dot = true,
	color = "primary",
} = Astro.props;
---

<Tag
	class:list={[
		"font-display font-bold uppercase gap-4 mb-6 sm:mb-8",
		size === "large" ? "text-4xl sm:text-6xl" : "text-3xl sm:text-4xl",
		className,
	]}
>
	<slot />
	{dot && <span style={`color: var(--${color})`}>.</span>}
</Tag>
