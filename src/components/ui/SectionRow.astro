---
interface Props {
	split?: number;
	class?: string;
}

const { split = 0.5, class: className } = Astro.props;
---

<div class:list={["section-row grid", className]} style={`--split: ${split}`}>
	<slot />
</div>

<style>
	@media (width >= 64rem) {
		.section-row {
			--container: 64rem;
			grid-template-columns: calc(50% + (var(--split) - 0.5) * var(--container)) minmax(0, 1fr);
		}
		.section-row > :global(:first-child > div) {
			max-width: calc(var(--split) * var(--container));
			margin-right: 0;
		}
		.section-row > :global(:last-child > div) {
			max-width: calc((1 - var(--split)) * var(--container));
			margin-left: 0;
		}
	}
	@media (width >= 80rem) {
		.section-row {
			--container: 80rem;
		}
	}
	@media (width >= 96rem) {
		.section-row {
			--container: 96rem;
		}
	}
</style>
