---
import Corners from "./Corners.astro";

const date = new Date();
const year = date.getFullYear() + (date.getMonth() >= 9 ? 1 : 0);

const { class: className } = Astro.props;
---

<section
	id="hero"
	class:list={["relative flex items-center justify-center", className]}
>
	<Corners class="size-16 opacity-30" />

	<div class="relative text-center px-4 mx-auto z-10">
		<div class="border-4 p-12 bg-bg text-text shadow-2xl relative">
			<Corners style="sides" class="size-4" />

			<div class="text-xs mb-4 tracking-widest opacity-60 uppercase">
				/// Competing in {year} Eurobot
			</div>
			<h1
				class="text-5xl md:text-7xl font-bold mb-6 tracking-tight uppercase"
			>
				R.U.R.<br />Robotics
			</h1>
			<div class="w-32 h-1 bg-text mx-auto mb-6"></div>
			<p class="text-lg md:text-xl mb-8 max-w-2xl mx-auto">
				Designing, Building, and Competing with Autonomous Robots
			</p>
			<a
				href="#about"
				class="border-2 border-text px-8 py-3 hover:bg-text hover:text-bg transition-all inline-block font-bold uppercase"
			>
				Explore
			</a>
		</div>
	</div>
</section>
