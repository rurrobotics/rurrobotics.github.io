---
const sides = [
	"-top-[2px] -left-[2px] -translate-1/2",
	"-top-[2px] -right-[2px] translate-x-1/2 -translate-y-1/2",
	"-bottom-[2px] -left-[2px] -translate-x-1/2 translate-y-1/2",
	"-bottom-[2px] -right-[2px] translate-1/2",
];
const borders = [
	"top-0 left-0 translate-1/2 border-t-4 border-l-4",
	"top-0 right-0 -translate-x-1/2 translate-y-1/2 border-t-4 border-r-4",
	"bottom-0 left-0 translate-x-1/2 -translate-y-1/2 border-b-4 border-l-4",
	"bottom-0 right-0 -translate-1/2 border-b-4 border-r-4",
];

const date = new Date();
const year = date.getFullYear() + (date.getMonth() >= 9 ? 1 : 0);

const { class: className } = Astro.props
---

<section
	id="hero"
	class:list={["relative flex items-center justify-center", className]}
>
	{
		borders.map((cls) => (
			<div class:list={["absolute size-16 opacity-30", cls]} />
		))
	}

	<div class="relative text-center px-4 mx-auto z-10">
		<div class="border-4 p-12 bg-bg text-text shadow-2xl relative">
			{
				sides.map((cls) => (
					<div
						class={`absolute ${cls} size-6 border-2 bg-bg rotate-45`}
					/>
				))
			}

			<div class="text-xs mb-4 tracking-widest opacity-60">
				/// COMPETING IN {year} EUROBOT
			</div>
			<h1 class="text-5xl md:text-7xl font-bold mb-6 tracking-tight">
				R.U.R.<br />ROBOTICS
			</h1>
			<div class="w-32 h-1 bg-text mx-auto mb-6"></div>
			<p class="text-lg md:text-xl mb-8 max-w-2xl mx-auto">
				Designing, Building, and Competing with Autonomous Robots
			</p>
			<a
				href="#about"
				class="border-2 px-8 py-3 hover:bg-text hover:text-bg transition-all inline-block font-bold"
			>
				EXPLORE
			</a>
		</div>
	</div>
</section>
