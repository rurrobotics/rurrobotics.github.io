---
const sides = [
	"-top-[2px] -left-[2px] -translate-1/2",
	"-top-[2px] -right-[2px] translate-x-1/2 -translate-y-1/2",
	"-bottom-[2px] -left-[2px] -translate-x-1/2 translate-y-1/2",
	"-bottom-[2px] -right-[2px] translate-1/2",
];
const borders = [
	"top-0 left-0 translate-1/2 border-t-4 border-l-4",
	"top-0 right-0 -translate-x-1/2 translate-y-1/2 border-t-4 border-r-4",
	"bottom-0 left-0 translate-x-1/2 -translate-y-1/2 border-b-4 border-l-4",
	"bottom-0 right-0 -translate-1/2 border-b-4 border-r-4",
];
const smallBorders = [
	"top-0 left-0 translate-1/2 border-t-2 border-l-2",
	"top-0 right-0 -translate-x-1/2 translate-y-1/2 border-t-2 border-r-2",
	"bottom-0 left-0 translate-x-1/2 -translate-y-1/2 border-b-2 border-l-2",
	"bottom-0 right-0 -translate-1/2 border-b-2 border-r-2",
]

interface Props {
	class?: string;
	style?: "sides" | "borders" | "smallborders";
}

const { class: className, style = "borders" } = Astro.props;

const MAPPING = {
    "borders": [borders, ""],
	"smallborders": [smallBorders, ""],
    "sides": [sides, "border-2 bg-bg"],
}
---

{
	MAPPING[style][0].map((cls: string) => (
		<div class:list={[`absolute`, MAPPING[style][1], cls, className]} />
	))
}