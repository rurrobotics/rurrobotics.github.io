---
import { MoveRight } from "@lucide/astro";
import {
	articleSlug,
	CATEGORY_COLORS,
	EVENT_TIME_ZONE,
	isEventCategory,
	type Article,
} from "@/articles";
import { defaultLocale, localeTags, type Locale } from "@locales/config.js";
import CategoryBadge from "@components/common/CategoryBadge.astro";

interface Props {
	article: Article;
}

const { article } = Astro.props;
const { data } = article;

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const localeTag = localeTags[locale];

const color = CATEGORY_COLORS[data.category];
const eventDate =
	isEventCategory(data.category) && "eventDate" in data
		? data.eventDate
		: undefined;

const timeZone = EVENT_TIME_ZONE;
const dateFmt = new Intl.DateTimeFormat(localeTag, {
	day: "2-digit",
	month: "short",
	year: "numeric",
	timeZone,
});
const timeFmt = new Intl.DateTimeFormat(localeTag, {
	hour: "2-digit",
	minute: "2-digit",
	timeZone,
});
---

<li
	data-category={data.category}
	data-year={(eventDate ?? data.date).getUTCFullYear()}
	data-search={`${data.title} ${data.description ?? ""}`}
>
	<a
		href={`/${locale}/articles/${articleSlug(article)}/`}
		class:list={[
			"group wipe wipe-top flex h-full flex-col border-4 border-foreground bg-background text-foreground",
			`wipe-${color}`,
		]}
	>
		<div class="wipe-strip h-3 shrink-0"></div>
		<div class="flex flex-1 flex-col gap-3 p-5">
			<div class="flex items-center justify-between gap-3">
				<CategoryBadge category={data.category} />
				<time
					datetime={data.date.toISOString()}
					class="wipe-text font-mono text-xs font-semibold text-muted"
				>
					{dateFmt.format(data.date)}
				</time>
			</div>
			<h3 class="font-display text-2xl leading-tight font-semibold">
				{data.title}
			</h3>
			{
				data.description && (
					<p class="wipe-text text-base leading-snug text-ink-muted">
						{data.description}
					</p>
				)
			}
			{
				eventDate && (
					<span class="mt-auto pt-2 font-mono text-xs font-semibold">
						{dateFmt.format(eventDate)} · {timeFmt.format(eventDate)}
					</span>
				)
			}
		</div>
		<div
			class="flex items-center justify-between gap-3 border-t-4 border-foreground px-5 py-3"
		>
			<span class="wipe-text min-w-0 truncate font-mono text-xs font-semibold text-muted">
				{data.author}
			</span>
			<MoveRight
				class="size-5 shrink-0 transition-transform group-hover:translate-x-0.5"
			/>
		</div>
	</a>
</li>
