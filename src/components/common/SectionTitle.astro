---
interface Props {
	class?: string;
	color?: "primary" | "secondary" | "accent" | "tertiary";
}

const { class: className, color = "primary" } = Astro.props;
---

<div class:list={["flex items-center gap-4 mb-6 sm:mb-8", className]}>
	<h2 class="font-display font-bold text-3xl sm:text-4xl uppercase">
		<slot />
	</h2>
	<div class="h-2 flex-1 bg-current"></div>
	<div class="size-2 shrink-0" style={`background: var(--${color})`}></div>
</div>
