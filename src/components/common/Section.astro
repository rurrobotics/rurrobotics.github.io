---
interface Props {
	id?: string;
	color?: "primary" | "secondary" | "accent" | "tertiary";
}

const { id, color } = Astro.props;
---

<section
	{id}
	class="border-t-8"
	style={color &&
		`background: var(--${color}); color: var(--${color}-foreground)`}
>
	<div class="mx-auto container px-5 py-10 sm:px-10 md:px-15 md:py-14">
		<slot />
	</div>
</section>
