---
import BrandIcon from "@components/icons/BrandIcon.astro";

interface Props {
	network: "instagram" | "linkedin" | "github";
	href: string;
}

const { network, href } = Astro.props;

const networks = {
	instagram: { label: "Instagram", color: "primary" },
	linkedin: { label: "LinkedIn", color: "tertiary" },
	github: { label: "GitHub", color: "secondary" },
} as const;

const { label, color } = networks[network];
---

<a
	href={href}
	aria-label={label}
	class="social flex size-12 items-center justify-center border-2 border-current"
	style={`--social-accent: var(--${color}); --social-accent-fg: var(--${color}-foreground)`}
>
	<BrandIcon name={network} class="size-6" />
</a>

<style>
	.social {
		background-image: linear-gradient(
			var(--social-accent),
			var(--social-accent)
		);
		background-repeat: no-repeat;
		background-position: left;
		background-size: 0% 100%;
		transition:
			background-size 0.15s ease,
			border-color 0.1s ease,
			color 0.1s ease;
	}
	.social:hover,
	.social:focus-visible {
		background-size: 100% 100%;
		border-color: var(--social-accent);
		color: var(--social-accent-fg);
		transition-delay: 150ms;
	}
</style>
