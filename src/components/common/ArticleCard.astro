---
import {
	articleSlug,
	isEventCategory,
	type Article,
	type ArticleCategory,
} from "@/articles";
import { defaultLocale, localeTags, type Locale } from "@locales/config.js";
import { MoveRight } from "@lucide/astro";
import Badge from "@components/common/Badge.astro";

interface Props {
	article: Article;
	past?: boolean;
}

const { article, past = false } = Astro.props;
const { data } = article;

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const localeTag = localeTags[locale];

const isEvent = isEventCategory(data.category);
const eventDate = "eventDate" in data ? data.eventDate : undefined;

const categoryColors = {
	meetup: "primary",
	lecture: "accent",
	news: "tertiary",
	writeup: "secondary",
} as const satisfies Record<ArticleCategory, string>;

const categoryLabels = {
	meetup: "Meetup",
	lecture: "Lecture",
	news: "News",
	writeup: "Writeup",
} as const satisfies Record<ArticleCategory, string>;

const dayFmt = new Intl.DateTimeFormat(localeTag, { day: "2-digit" });
const monthFmt = new Intl.DateTimeFormat(localeTag, { month: "short" });
const timeFmt = new Intl.DateTimeFormat(localeTag, {
	hour: "2-digit",
	minute: "2-digit",
});
const dateFmt = new Intl.DateTimeFormat(localeTag, {
	month: "short",
	year: "numeric",
});
---

<li>
	<a
		href={`/${locale}/articles/${articleSlug(article)}/`}
		class:list={[
			"group wipe wipe-left flex border-4 bg-background",
			past ? "text-muted border-muted" : "text-foreground",
			past ? "wipe-muted" : isEvent ? "wipe-tertiary" : "wipe-primary",
		]}
	>
		{
			!(isEvent && eventDate) && (
				<div class="wipe-strip w-3.5 shrink-0 self-stretch" />
			)
		}
		{
			isEvent && eventDate && (
				<div
					class:list={[
						"flex w-16 sm:w-26 shrink-0 flex-col items-center justify-center gap-0.5",
						past
							? "bg-muted border-muted text-muted-foreground"
							: "bg-tertiary text-tertiary-foreground",
					]}
				>
					<span class="font-display text-2xl sm:text-4xl font-bold leading-none">
						{dayFmt.format(eventDate)}
					</span>
					<span class="font-mono text-xs font-bold uppercase tracking-widest">
						{monthFmt.format(eventDate)}
					</span>
				</div>
			)
		}
		<div
			class="flex min-w-0 flex-1 flex-col justify-center gap-1 px-2.5 py-2 sm:gap-2.5 sm:px-6 sm:py-5"
		>
			<div class="flex items-center gap-3">
				<Badge
					label={categoryLabels[data.category]}
					class="font-bold uppercase tracking-widest"
					color={categoryColors[data.category]}
					variant={past ? "outline" : "solid"}
				/>
				<span class="wipe-text font-mono text-xs font-semibold text-muted">
					{
						eventDate
							? past
								? eventDate.getFullYear()
								: timeFmt.format(eventDate)
							: data.author
								? data.author
								: dateFmt.format(data.date)
					}
				</span>
			</div>
			<span class="truncate text-xl font-semibold leading-snug">
				{data.title}
			</span>
		</div>
		<div class="flex shrink-0 items-center pr-6">
			<MoveRight
				class="size-5 transition-transform group-hover:translate-x-0.5"
			/>
		</div>
	</a>
</li>
