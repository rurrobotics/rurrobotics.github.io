---
interface Props {
	items?: {
		name: string;
		href: string;
	}[];
}
const { items = [] } = Astro.props;
---

<nav class="sticky top-0 z-30 border-b-(length:--border)">
	<div class="navbar container mx-auto items-stretch">
		<div class="navbar-start">
			<!-- TODO: Add scroll to top -->
			<a class="font-medium border-x-(length:--border) h-full px-4 hover:bg-[url(pattern.svg)]" href="#">
				<h1 class="py-2">RUR Robotics</h1>
			</a>
		</div>
		<div class="navbar-end">
			{
				items.map((item) => (
					<a
						class="font-medium h-full border-l-(length:--border) last:border-x-(length:--border) px-4 py-2 hover:bg-[url(pattern.svg)]"
						href={item.href}
					>
						{item.name}
					</a>
				))
			}
		</div>
	</div>
</nav>
