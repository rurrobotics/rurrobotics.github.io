---
interface Props {
	items?: {
		name: string;
		href: string;
	}[];
}
const { items = [] } = Astro.props;
---

<nav class="sticky top-0 z-30 border-b-(length:--border)">
	<div class="navbar container mx-auto items-stretch">
		<div class="navbar-start">
			<!-- TODO: Add scroll to top -->
			<div class="border-x-2">
				<a
					class="inline-block px-1 py-1 hover:bg-[url(/pattern.svg)]"
					href="#"
				>
					<h1 class="px-3 py-1 bg-base-100">R.U.R. Robotics</h1>
				</a>
			</div>
		</div>
		<div class="navbar-end">
			{
				items.map((item) => (
					<div class="border-l-(length:--border) last:border-x-(length:--border)">
						<a
							class="inline-block h-full py-1 px-1 hover:bg-[url(/pattern.svg)]"
							href={item.href}
						>
							<div class="py-1 px-3 bg-base-100">
								{item.name}
							</div>
						</a>
					</div>
				))
			}
		</div>
	</div>
</nav>
