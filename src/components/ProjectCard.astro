---
import type { Project } from "../projects";
import { defaultLocale } from "../locales/config.js";
import { MoveRight } from "@lucide/astro";
import Badge from "./Badge.astro";

interface Props {
	project: Project;
	color?: "primary" | "secondary" | "accent" | "tertiary";
}

const { project, color = "primary" } = Astro.props;
const { name, description, url, tags } = project.data;

const locale = Astro.currentLocale ?? defaultLocale;
const localizedDescription = description[locale] ?? description[defaultLocale];
---

<a
	href={url}
	class="group card flex flex-col p-7 min-h-[200px] border-4 mt-[-4px] ml-[-4px]"
	style={`--card-accent: var(--${color}); --card-accent-fg: var(--${color}-foreground)`}
>
	<div class="-mx-7 -mt-7 mb-6 h-3.5" style="background:var(--card-accent)"></div>
	<span class="font-mono font-bold text-lg">{name}</span>
	{localizedDescription && <p class="mt-3 mb-auto text-sm leading-relaxed font-medium text-muted-foreground">{localizedDescription}</p>}
	<div class="flex items-center justify-between gap-2 mt-5">
		<div class="flex flex-wrap gap-2">
			{tags.map((tag) => <Badge label={tag} />)}
		</div>
		<MoveRight class="size-5 shrink-0 transition-transform group-hover:translate-x-0.5" />
	</div>
</a>

<style>
	.card {
		background-image: linear-gradient(var(--card-accent), var(--card-accent));
		background-repeat: no-repeat;
		background-position: top;
		background-size: 100% 0%;
		transition:
			background-size 0.15s ease,
			color 0.1s ease;
	}
	.card:hover {
		background-size: 100% 100%;
		color: var(--card-accent-fg);
		transition-delay: 150ms;
	}
	.card:hover p {
		color: var(--card-accent-fg);
		transition-delay: 150ms;
	}
</style>
