---
import {
	ARTICLE_CATEGORIES,
	articleListHref,
	getArticles,
} from "@lib/articles";
import { pageLocale } from "@locales/utils";
import Section from "@components/ui/Section.astro";
import SectionTitle from "@components/ui/SectionTitle.astro";
import ArticleCard from "@components/ui/ArticleCard.astro";
import SectionLink from "@components/ui/SectionLink.astro";

const locale = pageLocale(Astro.currentLocale);
const href = articleListHref(locale, ARTICLE_CATEGORIES);
const articles = await getArticles(locale, false);
---

<Section id="articles" color="tertiary">
	<SectionTitle slot="title">Articles</SectionTitle>
	<SectionLink slot="link" href={href} color="secondary">
		All articles
	</SectionLink>
	{articles.length === 0 ? (
		<p class="font-mono text-sm opacity-75">No articles yet.</p>
	) : (
		<ul class="grid grid-cols-1 gap-6">
			{articles.slice(0, 4).map((article) => (
				<ArticleCard article={article} />
			))}
		</ul>
	)}
</Section>
