---
import { EVENT_CATEGORIES, articleListHref, getArticles } from "@lib/articles";
import { pageLocale } from "@locales/utils";
import Section from "@components/ui/Section.astro";
import SectionTitle from "@components/ui/SectionTitle.astro";
import ArticleCard from "@components/ui/ArticleCard.astro";
import SectionLink from "@components/ui/SectionLink.astro";

const locale = pageLocale(Astro.currentLocale);
const href = articleListHref(locale, EVENT_CATEGORIES);
const events = await getArticles(locale, true);

const now = Date.now();
const upcoming = events
	.filter((e) => e.data.eventDate.valueOf() >= now)
	.sort((a, b) => a.data.eventDate.valueOf() - b.data.eventDate.valueOf());
const past = events
	.filter((e) => e.data.eventDate.valueOf() < now)
	.sort((a, b) => b.data.eventDate.valueOf() - a.data.eventDate.valueOf());
---

<Section id="events">
	<SectionTitle slot="title">Events</SectionTitle>
	<SectionLink slot="link" href={href}>
		All events
	</SectionLink>
	{
		upcoming.length === 0 ? (
			<p class="font-mono text-sm text-muted">
				No upcoming events.
			</p>
		) : (
			<ul data-upcoming class="grid grid-cols-1 gap-6">
				{upcoming.map((event) => (
					<ArticleCard article={event} />
				))}
			</ul>
		)
	}
	<p data-no-upcoming hidden class="font-mono text-sm text-muted">
		No upcoming events.
	</p>

	{
		events.length > 0 ? (
			<div data-past-block hidden={past.length === 0}>
				<h3 class="mt-10 mb-6 font-display text-2xl font-bold uppercase text-muted">
					Past events
				</h3>
				<ul data-past class="grid grid-cols-1 gap-6">
					{[...upcoming].reverse().map((event) => (
						<ArticleCard article={event} past hidden />
					))}
					{past.slice(0, 2).map((event) => (
						<ArticleCard article={event} past />
					))}
				</ul>
			</div>
		) : null
	}
</Section>

<script>
	const now = Date.now();
	const isPast = (item: HTMLElement) => Number(item.dataset.eventTime) < now;

	const list = document.querySelector<HTMLElement>("[data-upcoming]");
	const items = list?.querySelectorAll<HTMLElement>("li") ?? [];

	for (const item of items) item.hidden = isPast(item);

	if (list && [...items].every((item) => item.hidden)) {
		list.hidden = true;
		document.querySelector<HTMLElement>("[data-no-upcoming]")!.hidden = false;
	}

	let shown = 0;
	for (const item of document.querySelectorAll<HTMLElement>("[data-past] > li")) {
		item.hidden = !isPast(item) || shown >= 2;
		if (!item.hidden) shown++;
	}

	document.querySelector<HTMLElement>("[data-past-block]")!.hidden = shown === 0;
</script>
