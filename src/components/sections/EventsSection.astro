---
import { EVENT_CATEGORIES, getArticles } from "@lib/articles";
import { pageLocale } from "@locales/utils";
import Section from "@components/ui/Section.astro";
import SectionTitle from "@components/ui/SectionTitle.astro";
import ArticleCard from "@components/ui/ArticleCard.astro";
import SectionLink from "@components/ui/SectionLink.astro";

const locale = pageLocale(Astro.currentLocale);
const href = `/${locale}/articles/?category=${EVENT_CATEGORIES.join(",")}`;
const events = await getArticles(locale, true);

const now = Date.now();
const upcoming = events
	.filter((e) => e.data.eventDate.valueOf() >= now)
	.sort((a, b) => a.data.eventDate.valueOf() - b.data.eventDate.valueOf());
const past = events
	.filter((e) => e.data.eventDate.valueOf() < now)
	.sort((a, b) => b.data.eventDate.valueOf() - a.data.eventDate.valueOf());
---

<Section id="events">
	<SectionTitle slot="title">Events</SectionTitle>
	<SectionLink slot="link" href={href}>
		All events
	</SectionLink>
	{
		upcoming.length === 0 ? (
			<p class="font-mono text-sm text-muted">
				No upcoming events.
			</p>
		) : (
			<ul class="grid grid-cols-1 gap-6">
				{upcoming.map((event) => (
					<ArticleCard article={event} />
				))}
			</ul>
		)
	}

	{
		past.length > 0 ? (
			<div>
				<h3 class="mt-10 mb-6 font-display text-2xl font-bold uppercase text-muted">
					Past events
				</h3>
				<ul class="grid grid-cols-1 gap-6">
					{past.slice(0, 2).map((event) => (
						<ArticleCard article={event} past />
					))}
				</ul>
			</div>
		) : null
	}
</Section>
