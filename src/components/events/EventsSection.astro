---
import { getEventArticles } from "@/articles";
import { defaultLocale, type Locale } from "@locales/config.js";
import Section from "@components/common/Section.astro";
import SectionTitle from "@components/common/SectionTitle.astro";
import ArticleCard from "@components/common/ArticleCard.astro";
import SectionLink from "@components/common/SectionLink.astro";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const events = await getEventArticles(locale);

const now = Date.now();
const upcoming = events
	.filter((e) => e.data.eventDate.valueOf() >= now)
	.sort((a, b) => a.data.eventDate.valueOf() - b.data.eventDate.valueOf());
const past = events
	.filter((e) => e.data.eventDate.valueOf() < now)
	.sort((a, b) => b.data.eventDate.valueOf() - a.data.eventDate.valueOf());
---

<Section id="events">
	<SectionTitle>Events</SectionTitle>
	{
		upcoming.length === 0 ? (
			<p class="font-mono text-sm text-muted">
				No upcoming events.
			</p>
		) : (
			<ul class="grid gap-6 lg:grid-cols-2">
				{upcoming.map((event) => (
					<ArticleCard article={event} />
				))}
			</ul>
		)
	}

	{
		past.length > 0 ? (
			<div>
				<h3 class="mt-10 mb-6 font-display text-2xl font-bold uppercase text-muted">
					Past events
				</h3>
				<ul class="grid gap-6 lg:grid-cols-2">
					{past.slice(0, 2).map((event) => (
						<ArticleCard article={event} past />
					))}
				</ul>
			</div>
		) : null
	}
	{
		past.length > 2 && (
			<SectionLink href={`/${locale}/articles/`}>
				All past events
			</SectionLink>
		)
	}
</Section>
