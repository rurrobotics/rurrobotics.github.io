---
import Section from "@components/common/Section.astro";
import SectionTitle from "@components/common/SectionTitle.astro";
---

<Section id="about" class="">
	<SectionTitle slot="title">The team</SectionTitle>
	<p class="max-w-184 text-lg leading-relaxed">
		Founded in 2023 as a <a
			class="italic text-tertiary font-medium"
			href="https://www.eurobot.org/">Eurobot</a
		> team, we've since grown into the robotics club of the School of
		Electrical Engineering at the University of Belgrade. Our members
		come from faculties across the university, building autonomous robots
		that bring together mechanics, electronics and software.
	</p>
</Section>
