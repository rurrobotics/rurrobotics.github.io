#: src/pages/[lang]/join/index.astro
msgid "Apply to join RUR Robotics, the robotics club of the School of Electrical Engineering at the University of Belgrade."
msgstr "Пријави се за чланство у РУР Роботици, клубу роботике Електротехничког факултета Универзитета у Београду."

#: src/pages/[lang]/join/index.astro
msgid "What happens next"
msgstr "Шта следи"

#: src/components/ui/JoinForm.astro
msgid "Thanks! We got your application and will be in touch soon."
msgstr "Хвала! Примили смо твоју пријаву и ускоро ћемо ти се јавити."

#: src/components/ui/JoinForm.astro
msgid "Something went wrong. Check your answers and try again."
msgstr "Нешто је пошло по злу. Провери одговоре и покушај поново."

#: src/pages/[lang]/join/index.astro
msgid "Fill in the form."
msgstr "Попуни формулар."

#: src/pages/[lang]/join/index.astro
msgid "We email you when the selection round starts."
msgstr "Мејлом ти јављамо када почиње круг селекције."

#: src/pages/[lang]/join/index.astro
msgid "Pass the round and pick a project."
msgstr "Прођи круг и изабери пројекат."

#: src/components/ui/JoinForm.astro
msgid "Enter your name."
msgstr "Унеси своје име."

#: src/components/ui/JoinForm.astro
msgid "Enter a valid email."
msgstr "Унеси исправан имејл."

#: src/components/ui/JoinForm.astro
msgid "Enter a valid phone number."
msgstr "Унеси исправан број телефона."

#: src/components/ui/JoinForm.astro
msgid "Enter your faculty."
msgstr "Унеси свој факултет."

#: src/components/ui/JoinForm.astro
msgid "Enter a year from 1 to 6."
msgstr "Унеси годину од 1 до 6."

#: src/components/ui/JoinForm.astro
msgid "We couldn't confirm you're human. Complete the check and try again."
msgstr "Нисмо успели да потврдимо да си човек. Заврши проверу и покушај поново."

