---
import "@/styles/global.css";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import FontPreloads from "@components/layout/FontPreloads.astro";
import { localeTags } from "@locales/config.js";
import { pageLocale } from "@locales/utils";
import team from "@/assets/team.jpg";

interface Props {
	description: string;
	title?: string;
	image?: ImageMetadata;
	type?: "website" | "article";
	noindex?: boolean;
}

const {
	description,
	title,
	image = team,
	type = "website",
	noindex = false,
} = Astro.props;
const locale = pageLocale(Astro.currentLocale);

const ogLocales = { en: "en_US", sr: "sr_RS", "sr-Cyrl": "sr_RS" };
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const ogImage = await getImage({ src: image, width: 1200, format: "jpeg" });
const ogImageUrl = new URL(ogImage.src, Astro.site);
---

<html lang={localeTags[locale]}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link
			rel="alternate"
			type="application/rss+xml"
			title="RUR Robotics"
			href={`/${locale}/articles/rss.xml`}
		/>
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<FontPreloads />
		<title>{title ? `${title} | RUR Robotics` : 'RUR Robotics'}</title>
		<meta name="description" content={description} />
		<meta name="robots" content={noindex ? "noindex" : "index, follow"} />

		<meta property="og:site_name" content="RUR Robotics" />
		<meta property="og:title" content={title ?? "RUR Robotics"} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={type} />
		<meta property="og:url" content={pageUrl.href} />
		<meta property="og:image" content={ogImageUrl.href} />
		<meta property="og:locale" content={ogLocales[locale]} />
		<meta name="twitter:card" content="summary_large_image" />
	</head>
	<body>
		<slot />
	</body>
</html>
