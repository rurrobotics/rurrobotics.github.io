---
import BaseLayout from "./BaseLayout.astro";
interface Props {
	description?: string;
	keywords?: string[];
	url?: string;
	image?: string;
}
const { ...props } = Astro.props;
---

<BaseLayout title="R.U.R. Robotics" {...props}>
	<slot name="head" slot="head" />
	<main class="flex-1 relative">
		<slot />
	</main>
	<footer class="shrink-0">
	</footer>
</BaseLayout>
