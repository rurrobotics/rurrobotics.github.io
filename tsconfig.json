{
	"extends": "astro/tsconfigs/strict",
	"include": [
		".astro/types.d.ts",
		"**/*"
	],
	"exclude": [
		"dist"
	],
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"@components/*": [
				"src/components/*"
			],
			"@locales/*": [
				"src/locales/*"
			],
			"@layouts/*": [
				"src/layouts/*"
			],
			"@/*": [
				"src/*"
			]
		}
	}
}